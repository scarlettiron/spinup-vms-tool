class {{formula_class}} < Formula
  desc "{{homebrew_desc}}"
  homepage "{{homepage}}"
  version "{{version}}"
  license "{{license}}"

  #Prebuilt binaries from the GitHub Release, one per OS and CPU.
  on_macos do
    on_arm do
      url "{{url_aarch64_apple_darwin}}"
      sha256 "{{sha256_aarch64_apple_darwin}}"
    end
    on_intel do
      url "{{url_x86_64_apple_darwin}}"
      sha256 "{{sha256_x86_64_apple_darwin}}"
    end

    #The macOS backend drives Apple's Virtualization.framework through vfkit,
    #so brew installs it alongside.
    depends_on "vfkit"
  end

  on_linux do
    on_arm do
      url "{{url_aarch64_unknown_linux_gnu}}"
      sha256 "{{sha256_aarch64_unknown_linux_gnu}}"
    end
    on_intel do
      url "{{url_x86_64_unknown_linux_gnu}}"
      sha256 "{{sha256_x86_64_unknown_linux_gnu}}"
    end
  end

  def install
    bin.install "{{name}}"

    #Runs "{{name}} completion bash", "... zsh" and "... fish" and installs the results.
    generate_completions_from_executable(bin/"{{name}}", "completion", shells: [:bash, :zsh, :fish])
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/{{name}} --version")
  end
end
